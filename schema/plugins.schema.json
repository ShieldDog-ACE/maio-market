{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ShieldDog-ACE/maio-market/schema/plugins.schema.json",
  "title": "maio plugin market",
  "type": "object",
  "required": ["schema", "plugins"],
  "additionalProperties": true,
  "properties": {
    "schema": { "const": 1 },
    "updated": { "type": "string" },
    "plugins": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "author", "repo", "description"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 48,
            "pattern": "^[a-z0-9][a-z0-9_-]*$"
          },
          "author": { "type": "string", "minLength": 1, "maxLength": 64 },
          "repo": {
            "type": "string",
            "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
          },
          "description": { "type": "string", "minLength": 1, "maxLength": 280 },
          "branch": { "type": "string", "minLength": 1, "maxLength": 64 },
          "tags": {
            "type": "array",
            "maxItems": 8,
            "items": { "type": "string", "minLength": 1, "maxLength": 24 }
          }
        }
      }
    }
  }
}
